flowchart TB
    U["👤 Francisco\nMensaje de usuario"]

    HOOK["🪝 Hook UserPromptSubmit\n.claude/hooks/leader-gate.sh\nInyecta regla de enrutado + git status"]

    HILO["🧵 Hilo principal\nNO responde: delega siempre en leader\n(única excepción: configurar el propio\nandamiaje — settings.json, hooks,\n.claude/agents/, skills, .mcp.json)"]

    LEADER["🎯 leader\nClasifica en CARRIL + TRACK\nDespacha lo que no requiere conversación\nNUNCA escribe código ni notas"]

    subgraph CARRILES["Carriles (interroga? · ficha? · cierre?)"]
        direction LR
        C1["Consulta\nPregunta sobre estado/resultados/decisión\nNo interroga · sin ficha · sin cierre"]
        C2["Intervención\nCambio pequeño y entendido\nNo interroga · sin ficha · SÍ cierre"]
        C3["Tarea\nAlcance nuevo a definir\ngrill-me · SÍ ficha · SÍ cierre"]
        C4["Investigación\nPedir investigar algo que no está en disco\nInterroga salvo encargo ya cerrado\nsin ficha · sin cierre"]
    end

    subgraph COD["⚙️ Track CÓDIGO"]
        direction TB
        IMP["🔨 ml-implementador\nEscribe/modifica program · validacion ·\nanomalias · firmas · baseline · hibrido ·\ncascada_invertida · config · evaluacion"]
        AUD["🔍 auditor-ml (OBLIGATORIO, solo lectura)\nQuien escribe no puede auditar\nPase separado, instrucción adversaria"]
        EJE["▶️ ejecutor-experimentos\nCorre los scripts, valida salidas,\nreporta métricas clave"]
        IMP -->|"diff"| AUD
        IMP -.->|"NO APTO: corregir"| IMP
        IMP -->|"ejecutar"| EJE
    end

    subgraph INF["✍️ Track INFORME"]
        RED["redactor-tfg\nRedacta/reestructura notas en\nObsidian_TFG_Vault/"]
    end

    subgraph SINTRACK["Sin track"]
        direction LR
        RES["researcher\nInvestiga y verifica fuentes\nSOLO si el usuario lo pide explícitamente,\ncon encargo cerrado\nÚnico que edita Bibliografía.md"]
        CRO["cronista\nMantiene features.md\n(tareas abiertas ↔ cerradas)"]
    end

    CIERRE["🔒 skill cierre\nÚNICO que ejecuta git de escritura\n(add/commit/push) — siempre pregunta"]

    U --> HOOK --> HILO --> LEADER
    LEADER --> CARRILES
    C3 --> COD
    C3 --> INF
    LEADER -.->|"track código"| COD
    LEADER -.->|"track informe"| INF
    C2 -.->|"tras el cambio"| CIERRE
    C3 -.->|"al cerrar la ficha"| CIERRE
    AUD -->|"APTO"| CIERRE
    RED -->|"notas escritas"| CIERRE
    CIERRE -->|"actualiza"| CRO

    NOTE["🧩 Despacho en paralelo (desde 2026-08-13)\nUnidad = FICHERO, no tema\nNunca en paralelo: misma nota, Bibliografía.md,\nfeatures.md, 00 Índice TFG.md, numeración [n],\nel pase de auditor-ml (va después)\nSí en paralelo: varios auditor-ml (solo lectura)"]

